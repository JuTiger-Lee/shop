# (선택) 비워 두면 토스 공식 문서의 공개 결제위젯 테스트 키를 사용합니다.
# 본인 키를 쓰려면 개발자센터의 "결제위젯 연동 키" 클라이언트 키를 넣으세요.
# 이 파일을 .env 로 복사한 뒤 값을 채워 주세요. (.env 는 커밋하지 않습니다)
VITE_TOSS_CLIENT_KEY=

# 사이트 기준 URL (canonical, sitemap.xml, robots.txt, OG 태그에 사용)
# 비워 두면 Vercel 빌드 시 프로덕션 도메인(VERCEL_PROJECT_PRODUCTION_URL)을 자동 사용합니다.
# 커스텀 도메인을 연결했다면 반드시 지정하세요. 예) https://mono.example.com
SITE_URL=

# 검색엔진 소유 확인용 meta 태그 값 (content="..." 안의 값만 입력)
# Google Search Console > 속성 추가 > URL 접두어 > HTML 태그
GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 > 사이트 등록 > HTML 태그
NAVER_SITE_VERIFICATION=
